{
  "name": "parallax-display",
  "version": "0.3.0",
  "description": "Head-tracking parallax 3D display engine using webcam-based eye tracking",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./three": {
      "types": "./dist/three.d.ts",
      "import": "./dist/three.js",
      "require": "./dist/three.cjs"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js",
      "require": "./dist/react.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config vite.site.config.ts",
    "build": "vite build && tsc --emitDeclarationOnly",
    "prepare": "npm run build",
    "build:site": "vite build --config vite.site.config.ts",
    "preview": "vite preview --config vite.site.config.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@mediapipe/tasks-vision": "0.10.34",
    "react": ">=18.0.0",
    "three": ">=0.170.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@mediapipe/tasks-vision": {
      "optional": true
    }
  },
  "devDependencies": {
    "@mediapipe/tasks-vision": "0.10.34",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.172.0",
    "jsdom": "^30.1.3",
    "react": "^19.2.4",
    "react-dom": "^19.3.1",
    "three": "^0.172.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0",
    "vitest": "^3.2.7"
  },
  "license": "MIT"
}
